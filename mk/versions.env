# The tool versions that CI pins. Both the Makefile and .github/workflows/ci.yml read this file, so
# it holds only NAME=value lines (Make includes it, and CI appends the lines to $GITHUB_ENV).
#
# CI is the reference. Locally, `make lint` runs whatever is installed and warns when a version
# differs from these.

# The LLVM major version. CI installs it from apt.llvm.org, and it gives clang-format and
# clang-tidy.
LLVM_VERSION=23

# The ruff release, exactly.
RUFF_VERSION=0.17.5
